{"nodes": [{"id": "_claude_trabajo_mandarin_vida_diaria_notas_director", "label": "Notas del Director Unidad 3: HSK 1 \u00b7 Vida diaria", "file_type": "document", "source_file": ".claude/trabajo/mandarin/vida-diaria/notas-director.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_trabajo_mandarin_vida_diaria_notas_director_respaldo_parcial", "label": "Respaldo parcial: escribe solo lo que la cita dice", "file_type": "rationale", "source_file": ".claude/trabajo/mandarin/vida-diaria/notas-director.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Afirmaciones sin cita textual se marcan como 'simplificaci\u00f3n de la lecci\u00f3n'; evita reglas absolutas no respaldadas por las fuentes."}, {"id": "_claude_trabajo_mandarin_vida_diaria_notas_director_pinyin_del_silabo", "label": "Pinyin copiado del s\u00edlabo, nunca de memoria", "file_type": "rationale", "source_file": ".claude/trabajo/mandarin/vida-diaria/notas-director.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El pinyin de cada palabra se copia de su l\u00ednea del s\u00edlabo HSK; las citas de Kapiolani tra\u00edan entidades HTML rotas."}, {"id": "_claude_trabajo_mandarin_vida_diaria_notas_director_palabras_ya_ensenadas", "label": "Solo palabras ya ense\u00f1adas (progresi\u00f3n por unidad y lecci\u00f3n)", "file_type": "rationale", "source_file": ".claude/trabajo/mandarin/vida-diaria/notas-director.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cada lecci\u00f3n usa solo vocabulario y gram\u00e1tica de unidades y lecciones anteriores; ejemplos de fuentes con palabras fuera de nivel se rehacen."}, {"id": "_claude_trabajo_mandarin_vida_diaria_notas_director_maximo_6_grabaciones", "label": "M\u00e1ximo 6 grabaciones humanas por lecci\u00f3n", "file_type": "rationale", "source_file": ".claude/trabajo/mandarin/vida-diaria/notas-director.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decisi\u00f3n del usuario para respetar el tope de 2 MB de audio/; el resto usa la voz del sistema."}, {"id": "_claude_trabajo_mandarin_vida_diaria_notas_director_formato_extension", "label": "Formato y extensi\u00f3n de lecci\u00f3n (480-560 palabras, 6 ejercicios)", "file_type": "rationale", "source_file": ".claude/trabajo/mandarin/vida-diaria/notas-director.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicaci\u00f3n 480-560 palabras (tope 650), ejemplo 125-180, vida real 65-90; todo car\u00e1cter con zh(); helpers tabla/fila/p."}], "edges": [{"source": "_claude_trabajo_mandarin_vida_diaria_notas_director", "target": "_claude_trabajo_mandarin_vida_diaria_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/trabajo/mandarin/vida-diaria/notas-director.md", "source_location": null, "weight": 1.0}, {"source": "_claude_trabajo_mandarin_vida_diaria_notas_director", "target": "_claude_trabajo_mandarin_vida_diaria_ficha", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/trabajo/mandarin/vida-diaria/notas-director.md", "source_location": null, "weight": 1.0}, {"source": "_claude_trabajo_mandarin_vida_diaria_notas_director", "target": "_claude_trabajo_mandarin_vida_diaria_notas_director_respaldo_parcial", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/trabajo/mandarin/vida-diaria/notas-director.md", "source_location": null, "weight": 1.0}, {"source": "_claude_trabajo_mandarin_vida_diaria_notas_director", "target": "_claude_trabajo_mandarin_vida_diaria_notas_director_pinyin_del_silabo", "relation": "re